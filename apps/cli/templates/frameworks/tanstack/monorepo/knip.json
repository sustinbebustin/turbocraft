{
  "workspaces": {
    "apps/web": {
      "entry": ["src/router.tsx", "src/routes/**/*.{ts,tsx}", "vite.config.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["src/routeTree.gen.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/hooks/*.ts", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
