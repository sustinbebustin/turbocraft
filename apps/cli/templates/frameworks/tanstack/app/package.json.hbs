{
  "name": "{{projectName}}",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "{{#if withConvex}}convex dev --start \"vite dev\"{{else}}vite dev{{/if}}",{{#if withConvex}}
    "dev:web": "vite dev",
    "dev:convex": "convex dev",{{/if}}
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "effect-language-service patch && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "quality": "oxlint && oxfmt --check",
    "quality:fix": "oxlint --fix && oxfmt",
    "check:unused": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-router": "^1.169.0",
    "@tanstack/react-router-devtools": "^1.166.0",
    "@tanstack/react-router-ssr-query": "^1.166.0",
    "@tanstack/react-router-with-query": "^1.130.0",
    "@tanstack/react-start": "^1.167.0",
    "effect": "^3.21.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.12.0",
    "nitro": "^3.0.0-beta",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
