import "./globals.css";
import { Toaster } from "@/components/ui/sonner";
{{#if withConvex}}
import { ConvexClientProvider } from "@/components/convex-client-provider";
{{/if}}
import { ThemeProvider } from "@/components/theme-provider";
{{#if withBetterAuth}}
import { getToken } from "@/lib/auth-server";
{{/if}}

export default {{#if withBetterAuth}}async {{/if}}function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
{{#if withBetterAuth}}
  const token = await getToken();
{{/if}}
  return (
    <html
      lang="en"
      suppressHydrationWarning
      className="antialiased"
    >
      <body>
        <ThemeProvider>
{{#if withConvex}}
          <ConvexClientProvider{{#if withBetterAuth}} initialToken={token}{{/if}}>
            {children}
            <Toaster />
          </ConvexClientProvider>
{{else}}
          {children}
          <Toaster />
{{/if}}
        </ThemeProvider>
      </body>
    </html>
  );
}
