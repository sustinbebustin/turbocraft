{{#unless withShadcn}}
import { Geist_Mono, DM_Sans } from "next/font/google";
{{/unless}}

import "./globals.css";
{{#if withShadcn}}
import { Toaster } from "@/components/ui/sonner";
import { ThemeProvider } from "@/components/theme-provider";
{{/if}}
{{#if withConvex}}
import { ConvexClientProvider } from "@/components/convex-client-provider";
{{/if}}
{{#if withBetterAuth}}
import { getToken } from "@/lib/auth-server";
{{/if}}

{{#unless withShadcn}}
const dmSans = DM_Sans({ subsets: ["latin"], variable: "--font-sans" });

const fontMono = Geist_Mono({
  subsets: ["latin"],
  variable: "--font-mono",
});
{{/unless}}

export default {{#if withBetterAuth}}async {{/if}}function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
{{#if withBetterAuth}}
  const token = await getToken();
{{/if}}
  return (
    <html
      lang="en"
      suppressHydrationWarning
{{#if withShadcn}}
      className="antialiased"
{{else}}
      className={`antialiased font-sans ${fontMono.variable} ${dmSans.variable}`}
{{/if}}
    >
      <body>
{{#if withShadcn}}
        <ThemeProvider>
{{#if withConvex}}
          <ConvexClientProvider{{#if withBetterAuth}} initialToken={token}{{/if}}>
            {children}
            <Toaster />
          </ConvexClientProvider>
{{else}}
          {children}
          <Toaster />
{{/if}}
        </ThemeProvider>
{{else}}
{{#if withConvex}}
        <ConvexClientProvider{{#if withBetterAuth}} initialToken={token}{{/if}}>
          {children}
        </ConvexClientProvider>
{{else}}
        {children}
{{/if}}
{{/if}}
      </body>
    </html>
  );
}
