# --- App URL ---
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
{{#if withConvex}}

# --- Convex ---
# Generated by `npx convex dev` on first run. Don't fill these in by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
{{/if}}
{{#if withBetterAuth}}

# --- Better Auth secret (set on Convex, not in .env.local) ---
# Run once after `npx convex dev` finishes setup:
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"

# --- Optional: Google OAuth ---
# 1. Set the secrets on your Convex deployment:
#      npx convex env set GOOGLE_CLIENT_ID "<value>"
#      npx convex env set GOOGLE_CLIENT_SECRET "<value>"
# 2. Flip the public flag below to expose the button in the auth UI.
# NEXT_PUBLIC_OAUTH_GOOGLE=1

# --- Optional: GitHub OAuth ---
# 1. Set the secrets on your Convex deployment:
#      npx convex env set GITHUB_CLIENT_ID "<value>"
#      npx convex env set GITHUB_CLIENT_SECRET "<value>"
# 2. Flip the public flag below to expose the button in the auth UI.
# NEXT_PUBLIC_OAUTH_GITHUB=1
{{/if}}
